{
  "name": "reactive-fsm",
  "version": "2.0.0",
  "description": "State-scoped tool availability and tool budgets for TypeScript AI agents. Zero-dependency core, official Vercel AI SDK 7 adapter.",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.18.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/vercel-ai": {
      "types": "./dist/adapters/vercel-ai.d.ts",
      "import": "./dist/adapters/vercel-ai.js"
    },
    "./adapters/openai": {
      "types": "./dist/adapters/openai.d.ts",
      "import": "./dist/adapters/openai.js"
    },
    "./adapters/anthropic": {
      "types": "./dist/adapters/anthropic.d.ts",
      "import": "./dist/adapters/anthropic.js"
    },
    "./adapters/langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "import": "./dist/adapters/langchain.js"
    },
    "./adapters/gemini": {
      "types": "./dist/adapters/gemini.d.ts",
      "import": "./dist/adapters/gemini.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.tests.json",
    "prepublishOnly": "pnpm build && pnpm test && pnpm typecheck && pnpm validate:package",
    "validate:package": "publint && attw --pack . --profile esm-only"
  },
  "keywords": [
    "fsm",
    "finite-state-machine",
    "ai-agents",
    "vercel-ai-sdk",
    "openai",
    "anthropic",
    "langchain",
    "gemini",
    "tool-gating"
  ],
  "author": "Alejandro Alvarado (roddcode) <roddcode.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roddcode/reactive-fsm.git"
  },
  "bugs": {
    "url": "https://github.com/roddcode/reactive-fsm/issues"
  },
  "homepage": "https://github.com/roddcode/reactive-fsm#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "ai": "^7.0.171",
    "publint": "^0.3.24",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "zod": "^4.6.7"
  }
}
