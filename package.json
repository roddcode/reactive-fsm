{
  "name": "reactive-fsm",
  "version": "1.4.1",
  "description": "Deterministic control for AI agent tool calling: gate tools per conversation state, stop loops before they burn the turn. Zero-dependency core, adapters for 5 providers.",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.1.3",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/vercel-ai": {
      "types": "./dist/adapters/vercel-ai.d.ts",
      "import": "./dist/adapters/vercel-ai.js"
    },
    "./adapters/openai": {
      "types": "./dist/adapters/openai.d.ts",
      "import": "./dist/adapters/openai.js"
    },
    "./adapters/anthropic": {
      "types": "./dist/adapters/anthropic.d.ts",
      "import": "./dist/adapters/anthropic.js"
    },
    "./adapters/langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "import": "./dist/adapters/langchain.js"
    },
    "./adapters/gemini": {
      "types": "./dist/adapters/gemini.d.ts",
      "import": "./dist/adapters/gemini.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm test",
    "validate:package": "publint && attw --pack . --profile esm-only"
  },
  "keywords": [
    "fsm",
    "finite-state-machine",
    "ai-agents",
    "vercel-ai-sdk",
    "openai",
    "anthropic",
    "langchain",
    "gemini",
    "tool-gating"
  ],
  "author": "Alejandro Alvarado (roddcode) <roddcode.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roddcode/reactive-fsm.git"
  },
  "bugs": {
    "url": "https://github.com/roddcode/reactive-fsm/issues"
  },
  "homepage": "https://github.com/roddcode/reactive-fsm#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.24",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "ai": "^4.0.0",
    "openai": "^4.0.0",
    "@anthropic-ai/sdk": "^0.30.0",
    "langchain": "^0.3.0",
    "@google/generative-ai": "^0.21.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "langchain": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    }
  }
}
